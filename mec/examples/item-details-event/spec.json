{
 "name": "M3BOD_ItemDetails_Sync_Out_Custom",
 "version": "1.0",
 "namespace": "M3 BOD",
 "description": "M3 item event -> MMS200MI item details -> custom Sync.ItemDetails BOD",
 "schema_in": {
  "xsd": "EventData_MT.xsd",
  "name": "EventData_MT",
  "root": "EventData",
  "category": "Other"
 },
 "schema_out": {
  "xsd": "BODs-SyncItemDetails.xsd",
  "name": "BODs-SyncItemDetails",
  "root": "SyncItemDetails",
  "category": "BOD"
 },
 "properties": [
  {
   "type": "CP",
   "name": "StrictListCheck",
   "value": "true"
  }
 ],
 "constants": [],
 "variables": [
  {
   "name": "eventData",
   "type": "java.util.Map<String, String>",
   "init": "null",
   "desc": "Event element Name -> Value"
  },
  {
   "name": "CONO",
   "desc": "Company from the event (formatted)"
  },
  {
   "name": "ITNO",
   "desc": "Item number from the event"
  },
  {
   "name": "LANC",
   "desc": "User language (GetUserInfo)"
  },
  {
   "name": "bodAE",
   "desc": "Accounting entity of the BOD"
  },
  {
   "name": "tenantID",
   "desc": "Tenant id (on-premise translation)"
  },
  {
   "name": "LogicalID",
   "desc": "From logical id"
  },
  {
   "name": "dtGen",
   "type": "DataTranslator",
   "init": "null",
   "desc": "Generic data translator"
  },
  {
   "name": "strictLists",
   "type": "boolean",
   "init": "true",
   "desc": "CP StrictListCheck"
  },
  {
   "name": "g_Whs",
   "type": "java.util.List<String[]>",
   "init": "null",
   "desc": "Collected warehouse rows"
  },
  {
   "name": "g_Fac",
   "type": "java.util.List<String[]>",
   "init": "null",
   "desc": "Collected facility rows"
  },
  {
   "name": "g_Aun",
   "type": "java.util.List<String[]>",
   "init": "null",
   "desc": "Collected alternate U/M rows"
  },
  {
   "name": "g_WhsIt",
   "type": "java.util.Iterator<String[]>",
   "init": "null",
   "desc": "Warehouse iterator"
  },
  {
   "name": "g_FacIt",
   "type": "java.util.Iterator<String[]>",
   "init": "null",
   "desc": "Facility iterator"
  },
  {
   "name": "g_AunIt",
   "type": "java.util.Iterator<String[]>",
   "init": "null",
   "desc": "Alternate U/M iterator"
  },
  {
   "name": "g_Row",
   "type": "String[]",
   "init": "null",
   "desc": "Current output row"
  }
 ],
 "sequence": [
  {
   "java": "VersionLog",
   "desc": "Version log",
   "code": [
    "/*",
    " * M3BOD_ItemDetails_Sync_Out_Custom",
    " * FS: M3 item event -> retrieve all item details by ITNO -> custom Sync.ItemDetails BOD to ION.",
    " * v1.0  2026-11-04  Initial version (generated with iec-mapping-from-fs, KB v0.2)",
    " *   Event (EventData) -> ITNO/CONO -> MMS200MI GetItmBasic, LstItmWhsByItm, LstFacByItem, LstItmAltUnitMs",
    " *   Errors: missing ITNO/CONO, invalid item, API NOK -> MeCError (no BOD). Delete event -> abort (no BOD).",
    " */"
   ]
  },
  {
   "java": "InitEventData",
   "desc": "Create the event map and the collection lists",
   "code": [
    "eventData = new java.util.HashMap<String, String>();",
    "g_Whs = new java.util.ArrayList<String[]>();",
    "g_Fac = new java.util.ArrayList<String[]>();",
    "g_Aun = new java.util.ArrayList<String[]>();"
   ]
  },
  {
   "loop": "GetEventDataLoop",
   "cond": "WT",
   "ctl": "IN:/EventData/Document/ElementData",
   "desc": "One iteration per event element",
   "body": [
    {
     "java": "GetEventData",
     "desc": "Store each element Name/Value; ITNO and CONO accepted with or without the MM table prefix",
     "in": {
      "iName": "IN:/EventData/Document/ElementData/Name",
      "iValue": "IN:/EventData/Document/ElementData/Value"
     },
     "code": [
      "if (iName != null) {",
      "    String n = iName.trim();",
      "    String v = (iValue == null) ? \"\" : IONToolbox.rightTrim(iValue);",
      "    if (n.equals(\"ITNO\") || n.equals(\"MMITNO\")) {",
      "        eventData.put(\"ITNO\", v);            // item keys keep leading characters",
      "    } else if (n.equals(\"CONO\") || n.equals(\"MMCONO\")) {",
      "        eventData.put(\"CONO\", v.trim());",
      "    } else {",
      "        eventData.put(n, v.trim());",
      "    }",
      "}"
     ]
    }
   ]
  },
  {
   "java": "ManageEventData",
   "desc": "Validate the event: delete -> abort, missing ITNO/CONO -> MeCError",
   "in": {
    "iOperation": "IN:/EventData/Operation",
    "iDocumentName": "IN:/EventData/DocumentName",
    "iEventId": "IN:/EventData/EventId"
   },
   "out": {
    "oCONO": [
     "$CONO"
    ],
    "oITNO": [
     "$ITNO"
    ]
   },
   "code": [
    "String op = (iOperation == null) ? \"\" : iOperation.trim().toUpperCase();",
    "String doc = (iDocumentName == null) ? \"\" : iDocumentName.trim();",
    "String evt = (iEventId == null) ? \"\" : iEventId.trim();",
    "oCONO = eventData.get(\"CONO\");",
    "oITNO = eventData.get(\"ITNO\");",
    "oCONO = (oCONO == null) ? \"\" : oCONO.trim();",
    "oITNO = (oITNO == null) ? \"\" : oITNO;",
    "",
    "// Delete events: the item no longer exists in M3 - end without output",
    "if (op.equals(\"D\") || op.equals(\"DELETE\")) {",
    "    logInfo(\"ItemDetails: delete event \" + evt + \" for item '\" + oITNO + \"' - no BOD produced\");",
    "    abort(\"ItemDetails: delete event - no Sync.ItemDetails BOD\");   // ends the mapping, no output",
    "} else {",
    "    // Mandatory keys",
    "    if (IONToolbox.isEmpty(oITNO)) {",
    "        throw new MeCError(\"ItemDetails: item number (ITNO/MMITNO) missing in event \" + evt + \" [\" + doc + \"]\");",
    "    }",
    "    if (IONToolbox.isEmpty(oCONO)) {",
    "        throw new MeCError(\"ItemDetails: company (CONO/MMCONO) missing in event \" + evt + \" for item \" + oITNO);",
    "    }",
    "    logDebug(\"ItemDetails: event \" + evt + \" op=\" + op + \" CONO=\" + oCONO + \" ITNO=\" + oITNO);",
    "}"
   ]
  },
  {
   "java": "GetCONO_DIVI_AE",
   "desc": "Format company, company-level accounting entity",
   "in": {
    "iCONO": "$CONO"
   },
   "out": {
    "oCONO": [
     "$CONO"
    ],
    "oAE": [
     "$bodAE"
    ]
   },
   "code": [
    "// Get CONO",
    "oCONO = IONToolbox.formatCompany(iCONO);",
    "",
    "// Item master is company-level: accounting entity from M3 company only",
    "oAE = IONToolbox.getAccountingEntityId(oCONO, null);"
   ]
  },
  {
   "settings": {
    "Company": "GetCONO_DIVI_AE.oCONO"
   }
  },
  {
   "java": "Init",
   "desc": "DataTranslator, tenant id, control properties",
   "in": {
    "iCONO": "GetCONO_DIVI_AE.oCONO",
    "iTenantId": "IN:/EventData/TenantId"
   },
   "code": [
    "// Trim CONO:",
    "iCONO = iCONO == null ? \"\" : iCONO.trim();",
    "",
    "// Instantiate generic DataTranslator",
    "String blankDIVI = \"\";",
    "dtGen = new DataTranslator(getManifestMap(), iCONO, blankDIVI, \"ION\", \"1\", \"Generic\");",
    "",
    "// Set tenant id",
    "if (iTenantId == null) {",
    "    // On-premise: Translate M3 BE company to tenant id",
    "    tenantID = dtGen.toMessage(\"Generic\", \"TenantID\", iCONO, \"\", \"\", \"CMNCMP\", \"CONO\");",
    "    setManifestInfo(ManifestConstants.MAP_ION_TENANT_ID, tenantID);",
    "}",
    "",
    "// Control property StrictListCheck (default true): list API failure fails the message",
    "String strict = getManifestInfo(\"agr:StrictListCheck\");",
    "strictLists = !(strict != null && strict.trim().equalsIgnoreCase(\"false\"));"
   ]
  },
  {
   "api": "MMS200MI/GetUserInfo",
   "mode": "AVM",
   "in": {},
   "out": {
    "ZDLANC": [
     "$LANC"
    ]
   },
   "desc": "User language for descriptions and the BOD languageCode"
  },
  {
   "api": "MMS200MI/GetItmBasic",
   "mode": "AVI",
   "in": {
    "ITNO": "$ITNO",
    "LNCD": "$LANC"
   },
   "out": {},
   "desc": "Item master (MITMAS) - NOK checked in ValidateItem"
  },
  {
   "java": "ValidateItem",
   "desc": "Invalid item / API failure / empty response -> MeCError (no BOD)",
   "in": {
    "iITNO": "GetItmBasic.ITNO"
   },
   "code": [
    "if (!isLastAPICallOK()) {",
    "    throw new MeCError(\"ItemDetails: MMS200MI/GetItmBasic failed for item \" + ITNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage());",
    "}",
    "String rITNO = (iITNO == null) ? \"\" : IONToolbox.rightTrim(iITNO);",
    "if (IONToolbox.isEmpty(rITNO)) {",
    "    throw new MeCError(\"ItemDetails: MMS200MI/GetItmBasic returned no data for item \" + ITNO);",
    "}",
    "if (!rITNO.equals(ITNO)) {",
    "    throw new MeCError(\"ItemDetails: MMS200MI/GetItmBasic returned item \" + rITNO + \" for requested item \" + ITNO);",
    "}"
   ]
  },
  {
   "loop": "WarehouseLoop",
   "cond": "WT",
   "desc": "One iteration per MMS200MI/LstItmWhsByItm row",
   "body": [
    {
     "api": "MMS200MI/LstItmWhsByItm",
     "mode": "ARI",
     "in": {
      "ITNO": "$ITNO",
      "LNCD": "$LANC"
     },
     "out": {},
     "desc": "List warehouse records of the item (NOK checked in CheckWarehouse)"
    },
    {
     "java": "CollectWarehouse",
     "in": {
      "iITNO": "LstItmWhsByItm.ITNO",
      "iWHLO": "LstItmWhsByItm.WHLO",
      "iWHNM": "LstItmWhsByItm.WHNM",
      "iFACI": "LstItmWhsByItm.FACI",
      "iSTAT": "LstItmWhsByItm.STAT",
      "iRESP": "LstItmWhsByItm.RESP",
      "iBUYE": "LstItmWhsByItm.BUYE",
      "iSUNO": "LstItmWhsByItm.SUNO",
      "iPLCD": "LstItmWhsByItm.PLCD",
      "iORTY": "LstItmWhsByItm.ORTY",
      "iWHSL": "LstItmWhsByItm.WHSL",
      "iREOP": "LstItmWhsByItm.REOP",
      "iSSQT": "LstItmWhsByItm.SSQT",
      "iMXST": "LstItmWhsByItm.MXST",
      "iEOQT": "LstItmWhsByItm.EOQT",
      "iLEAT": "LstItmWhsByItm.LEAT",
      "iSTQT": "LstItmWhsByItm.STQT",
      "iAVAL": "LstItmWhsByItm.AVAL"
     },
     "out": {},
     "code": [
      "// One call per row returned by MMS200MI/LstItmWhsByItm. The list is positioned on the item key,",
      "// so rows of other items are skipped; only exact matches are kept.",
      "String rITNO = (iITNO == null) ? \"\" : IONToolbox.rightTrim(iITNO);",
      "if (rITNO.equals(ITNO)) {",
      "    String[] row = new String[17];",
      "    row[0] = (iWHLO == null) ? \"\" : iWHLO.trim();   // Warehouse",
      "    row[1] = (iWHNM == null) ? \"\" : iWHNM.trim();   // WarehouseName",
      "    row[2] = (iFACI == null) ? \"\" : iFACI.trim();   // Facility",
      "    row[3] = (iSTAT == null) ? \"\" : iSTAT.trim();   // Status",
      "    row[4] = (iRESP == null) ? \"\" : iRESP.trim();   // Responsible",
      "    row[5] = (iBUYE == null) ? \"\" : iBUYE.trim();   // Buyer",
      "    row[6] = (iSUNO == null) ? \"\" : iSUNO.trim();   // Supplier",
      "    row[7] = (iPLCD == null) ? \"\" : iPLCD.trim();   // PlanningPolicy",
      "    row[8] = (iORTY == null) ? \"\" : iORTY.trim();   // OrderType",
      "    row[9] = (iWHSL == null) ? \"\" : iWHSL.trim();   // DefaultLocation",
      "    row[10] = (iREOP == null) ? \"\" : iREOP.trim();   // ReorderPoint",
      "    row[11] = (iSSQT == null) ? \"\" : iSSQT.trim();   // SafetyStock",
      "    row[12] = (iMXST == null) ? \"\" : iMXST.trim();   // MaximumStock",
      "    row[13] = (iEOQT == null) ? \"\" : iEOQT.trim();   // EconomicOrderQuantity",
      "    row[14] = (iLEAT == null) ? \"\" : iLEAT.trim();   // LeadTime",
      "    row[15] = (iSTQT == null) ? \"\" : iSTQT.trim();   // OnHandApproved",
      "    row[16] = (iAVAL == null) ? \"\" : iAVAL.trim();   // AllocatableOnHand",
      "    g_Whs.add(row);",
      "}"
     ],
     "desc": "Keep rows of the event item in g_Whs"
    }
   ]
  },
  {
   "java": "CheckWarehouse",
   "code": [
    "// Runs after the MMS200MI/LstItmWhsByItm loop: the last API call is the list call itself.",
    "if (!isLastAPICallOK()) {",
    "    String msg = \"ItemDetails: MMS200MI/LstItmWhsByItm failed for item \" + ITNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage();",
    "    if (strictLists) {",
    "        throw new MeCError(msg);   // never send a BOD with a section silently missing",
    "    }",
    "    logWarn(msg + \" - warehouse section omitted (StrictListCheck=false)\");",
    "    g_Whs.clear();",
    "}",
    "logDebug(\"ItemDetails: \" + g_Whs.size() + \" warehouse record(s) for item \" + ITNO);"
   ],
   "desc": "API failure on MMS200MI/LstItmWhsByItm: fail the message (default) or omit the section"
  },
  {
   "loop": "FacilityLoop",
   "cond": "WT",
   "desc": "One iteration per MMS200MI/LstFacByItem row",
   "body": [
    {
     "api": "MMS200MI/LstFacByItem",
     "mode": "ARI",
     "in": {
      "ITNO": "$ITNO"
     },
     "out": {},
     "desc": "List facility records of the item (NOK checked in CheckFacility)"
    },
    {
     "java": "CollectFacility",
     "in": {
      "iITNO": "LstFacByItem.ITNO",
      "iFACI": "LstFacByItem.FACI",
      "iFACN": "LstFacByItem.FACN",
      "iSTAT": "LstFacByItem.STAT",
      "iFANO": "LstFacByItem.FANO"
     },
     "out": {},
     "code": [
      "// One call per row returned by MMS200MI/LstFacByItem. The list is positioned on the item key,",
      "// so rows of other items are skipped; only exact matches are kept.",
      "String rITNO = (iITNO == null) ? \"\" : IONToolbox.rightTrim(iITNO);",
      "if (rITNO.equals(ITNO)) {",
      "    String[] row = new String[4];",
      "    row[0] = (iFACI == null) ? \"\" : iFACI.trim();   // Facility",
      "    row[1] = (iFACN == null) ? \"\" : iFACN.trim();   // FacilityName",
      "    row[2] = (iSTAT == null) ? \"\" : iSTAT.trim();   // Status",
      "    row[3] = (iFANO == null) ? \"\" : iFANO.trim();   // OnHandBalance",
      "    g_Fac.add(row);",
      "}"
     ],
     "desc": "Keep rows of the event item in g_Fac"
    }
   ]
  },
  {
   "java": "CheckFacility",
   "code": [
    "// Runs after the MMS200MI/LstFacByItem loop: the last API call is the list call itself.",
    "if (!isLastAPICallOK()) {",
    "    String msg = \"ItemDetails: MMS200MI/LstFacByItem failed for item \" + ITNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage();",
    "    if (strictLists) {",
    "        throw new MeCError(msg);   // never send a BOD with a section silently missing",
    "    }",
    "    logWarn(msg + \" - facility section omitted (StrictListCheck=false)\");",
    "    g_Fac.clear();",
    "}",
    "logDebug(\"ItemDetails: \" + g_Fac.size() + \" facility record(s) for item \" + ITNO);"
   ],
   "desc": "API failure on MMS200MI/LstFacByItem: fail the message (default) or omit the section"
  },
  {
   "loop": "AlternateUOMLoop",
   "cond": "WT",
   "desc": "One iteration per MMS200MI/LstItmAltUnitMs row",
   "body": [
    {
     "api": "MMS200MI/LstItmAltUnitMs",
     "mode": "ARI",
     "in": {
      "FITN": "$ITNO",
      "TITN": "$ITNO",
      "LNCD": "$LANC"
     },
     "out": {},
     "desc": "List alternate U/M records of the item (NOK checked in CheckAlternateUOM)"
    },
    {
     "java": "CollectAlternateUOM",
     "in": {
      "iITNO": "LstItmAltUnitMs.ITNO",
      "iAUTP": "LstItmAltUnitMs.AUTP",
      "iALUN": "LstItmAltUnitMs.ALUN",
      "iTX40": "LstItmAltUnitMs.TX40",
      "iCOFA": "LstItmAltUnitMs.COFA",
      "iDMCF": "LstItmAltUnitMs.DMCF",
      "iDCCD": "LstItmAltUnitMs.DCCD",
      "iPCOF": "LstItmAltUnitMs.PCOF"
     },
     "out": {},
     "code": [
      "// One call per row returned by MMS200MI/LstItmAltUnitMs. The list is positioned on the item key,",
      "// so rows of other items are skipped; only exact matches are kept.",
      "String rITNO = (iITNO == null) ? \"\" : IONToolbox.rightTrim(iITNO);",
      "if (rITNO.equals(ITNO)) {",
      "    String[] row = new String[7];",
      "    row[0] = (iAUTP == null) ? \"\" : iAUTP.trim();   // UOMType",
      "    row[1] = (iALUN == null) ? \"\" : iALUN.trim();   // UOM",
      "    row[2] = (iTX40 == null) ? \"\" : iTX40.trim();   // Description",
      "    row[3] = (iCOFA == null) ? \"\" : iCOFA.trim();   // ConversionFactor",
      "    row[4] = (iDMCF == null) ? \"\" : iDMCF.trim();   // ConversionForm",
      "    row[5] = (iDCCD == null) ? \"\" : iDCCD.trim();   // DecimalPlaces",
      "    row[6] = (iPCOF == null) ? \"\" : iPCOF.trim();   // PriceAdjustmentFactor",
      "    g_Aun.add(row);",
      "}"
     ],
     "desc": "Keep rows of the event item in g_Aun"
    }
   ]
  },
  {
   "java": "CheckAlternateUOM",
   "code": [
    "// Runs after the MMS200MI/LstItmAltUnitMs loop: the last API call is the list call itself.",
    "if (!isLastAPICallOK()) {",
    "    String msg = \"ItemDetails: MMS200MI/LstItmAltUnitMs failed for item \" + ITNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage();",
    "    if (strictLists) {",
    "        throw new MeCError(msg);   // never send a BOD with a section silently missing",
    "    }",
    "    logWarn(msg + \" - alternate U/M section omitted (StrictListCheck=false)\");",
    "    g_Aun.clear();",
    "}",
    "logDebug(\"ItemDetails: \" + g_Aun.size() + \" alternate U/M record(s) for item \" + ITNO);"
   ],
   "desc": "API failure on MMS200MI/LstItmAltUnitMs: fail the message (default) or omit the section"
  },
  {
   "java": "SetOutboxHeaderData",
   "desc": "BOD type, accounting entity, target logical id, document id",
   "code": [
    "// BODType, hard coded here",
    "setManifestInfo(ManifestConstants.MAP_ION_BOD_TYPE, \"Sync.ItemDetails\"); // \"map:ionBODType\"",
    "",
    "// AccountingEntityID",
    "setManifestInfo(ManifestConstants.MAP_ION_ACCOUNTING_ENTITY, bodAE); // \"map:ionAccountingEntity\"",
    "",
    "// ToLogicalId, set from event when present",
    "if (!IONToolbox.isEmpty(eventData.get(\"ToLogicalId\"))) {",
    "    setManifestInfo(ManifestConstants.MAP_ION_TO_LOGICAL_ID, eventData.get(\"ToLogicalId\")); // \"map:ionToLogicalId\"",
    "}",
    "",
    "// Document id shown in ION OneView",
    "setManifestInfo(ManifestConstants.MAP_ION_DOCUMENT_ID, ITNO); // \"map:ionDocumentId\""
   ]
  },
  {
   "java": "SetHeader",
   "desc": "BOD root attributes and ApplicationArea",
   "in": {
    "iCONO": "$CONO",
    "iLANC": "$LANC",
    "iSentTimestamp": "IN:/EventData/SentTimestamp",
    "iBODID": null
   },
   "out": {
    "oReleaseID": [
     "OUT:/SyncItemDetails[@releaseID]"
    ],
    "oVersionID": [
     "OUT:/SyncItemDetails[@versionID]"
    ],
    "oSystemEnvironmentCode": [
     "OUT:/SyncItemDetails[@systemEnvironmentCode]"
    ],
    "oLanguageCode": [
     "OUT:/SyncItemDetails[@languageCode]"
    ],
    "oLogicalID": [
     "OUT:/SyncItemDetails/ApplicationArea/Sender/LogicalID",
     "$LogicalID"
    ],
    "oLogicalID_schemeVersionID": [
     "OUT:/SyncItemDetails/ApplicationArea/Sender/LogicalID[@schemeVersionID]"
    ],
    "oComponentID": [
     "OUT:/SyncItemDetails/ApplicationArea/Sender/ComponentID"
    ],
    "oComponentID_schemeVersionID": [
     "OUT:/SyncItemDetails/ApplicationArea/Sender/ComponentID[@schemeVersionID]"
    ],
    "oConfirmationCode": [
     "OUT:/SyncItemDetails/ApplicationArea/Sender/ConfirmationCode"
    ],
    "oCreationDateTime": [
     "OUT:/SyncItemDetails/ApplicationArea/CreationDateTime"
    ],
    "oBODID": [
     "OUT:/SyncItemDetails/ApplicationArea/BODID"
    ]
   },
   "code": [
    "// Set OAGIS release",
    "oReleaseID = \"9.2\";",
    "",
    "// Set version of the given BOD definition",
    "oVersionID = \"1.0.0\";",
    "",
    "// Set \"Test\" or \"Production\" (default) mode",
    "oSystemEnvironmentCode = getSystemEnvironmentCode();",
    "",
    "// Set language for the contents of the BOD",
    "if (iLANC != null) {",
    "    oLanguageCode = dtGen.toMessage(\"Generic\", \"languageCode\", iLANC, \"\", \"\", \"CSYTAB\",\"LNCD\");",
    "}",
    "",
    "// Set from logical ID",
    "oLogicalID = getFromLogicalID();",
    "",
    "// Set MEC mapping version",
    "oLogicalID_schemeVersionID = getMappingVersion();",
    "",
    "// Set business application that issued the BOD",
    "oComponentID = \"M3BE\";",
    "",
    "// Set M3 BE version",
    "oComponentID_schemeVersionID = getBEVersion();",
    "",
    "// Set date time stamp that the given instance of the BOD was created (UTC)",
    "oCreationDateTime = IONToolbox.normalizeXMLDateTime(iSentTimestamp);",
    "",
    "// Set GUID that will make each BOD instance uniquely identifiable, default MEC message UUID",
    "if (iBODID != null) {",
    "    oBODID = iBODID;",
    "} else {",
    "    oBODID = getMapUUID();",
    "}",
    "// Set ConfirmationCode",
    "oConfirmationCode = \"OnError\";"
   ]
