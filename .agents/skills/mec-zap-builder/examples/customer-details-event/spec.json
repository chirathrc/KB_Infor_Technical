{
 "name": "M3BOD_CustomerDetails_Sync_Out_Custom",
 "version": "1.0",
 "namespace": "M3 BOD",
 "description": "M3 customer event -> CRS610MI customer details -> custom Sync.CustomerDetails BOD",
 "schema_in": {
  "xsd": "EventData_MT.xsd",
  "name": "EventData_MT",
  "root": "EventData",
  "category": "Other"
 },
 "schema_out": {
  "xsd": "BODs-SyncCustomerDetails.xsd",
  "name": "BODs-SyncCustomerDetails",
  "root": "SyncCustomerDetails",
  "category": "BOD"
 },
 "properties": [
  {
   "type": "CP",
   "name": "StrictListCheck",
   "value": "true"
  }
 ],
 "constants": [],
 "variables": [
  {
   "name": "eventData",
   "type": "java.util.Map<String, String>",
   "init": "null",
   "desc": "Event element Name -> Value"
  },
  {
   "name": "CONO",
   "desc": "Company from the event (formatted)"
  },
  {
   "name": "CUNO",
   "desc": "Customer number from the event"
  },
  {
   "name": "LANC",
   "desc": "User language (GetUserInfo)"
  },
  {
   "name": "bodAE",
   "desc": "Accounting entity of the BOD"
  },
  {
   "name": "tenantID",
   "desc": "Tenant id (on-premise translation)"
  },
  {
   "name": "LogicalID",
   "desc": "From logical id"
  },
  {
   "name": "dtGen",
   "type": "DataTranslator",
   "init": "null",
   "desc": "Generic data translator"
  },
  {
   "name": "strictLists",
   "type": "boolean",
   "init": "true",
   "desc": "CP StrictListCheck"
  },
  {
   "name": "g_Adr",
   "type": "java.util.List<String[]>",
   "init": "null",
   "desc": "Collected address rows"
  },
  {
   "name": "g_AdrIt",
   "type": "java.util.Iterator<String[]>",
   "init": "null",
   "desc": "Address iterator"
  },
  {
   "name": "g_Row",
   "type": "String[]",
   "init": "null",
   "desc": "Current output row"
  }
 ],
 "sequence": [
  {
   "java": "VersionLog",
   "desc": "Version log",
   "code": [
    "/*",
    " * M3BOD_CustomerDetails_Sync_Out_Custom",
    " * FS: M3 customer event -> retrieve customer data by CUNO -> custom Sync.CustomerDetails BOD to ION.",
    " * v1.0  2026-11-10  Initial version (generated from KB_Infor_Technical mec F4 pattern)",
    " *   Event (EventData: CUNO/CONO, also OKCUNO/OKCONO from OCUSMA and IDCUNO/IDCONO from CIDMAS)",
    " *   -> CRS610MI GetBasicData, GetFinancial, GetOrderInfo, LstAddresses",
    " *   Errors: missing CUNO/CONO, invalid customer, API NOK -> MeCError (no BOD). Delete event -> abort (no BOD).",
    " */"
   ]
  },
  {
   "java": "InitEventData",
   "desc": "Create the event map and the collection lists",
   "code": [
    "eventData = new java.util.HashMap<String, String>();",
    "g_Adr = new java.util.ArrayList<String[]>();"
   ]
  },
  {
   "loop": "GetEventDataLoop",
   "cond": "WT",
   "ctl": "IN:/EventData/Document/ElementData",
   "desc": "One iteration per event element",
   "body": [
    {
     "java": "GetEventData",
     "desc": "Store each element Name/Value; CUNO and CONO accepted with or without the OK (OCUSMA) / ID (CIDMAS) table prefix",
     "in": {
      "iName": "IN:/EventData/Document/ElementData/Name",
      "iValue": "IN:/EventData/Document/ElementData/Value"
     },
     "code": [
      "if (iName != null) {",
      "    String n = iName.trim();",
      "    String v = (iValue == null) ? \"\" : IONToolbox.rightTrim(iValue);",
      "    if (n.equals(\"CUNO\") || n.equals(\"OKCUNO\") || n.equals(\"IDCUNO\")) {",
      "        eventData.put(\"CUNO\", v);            // customer keys keep leading characters",
      "    } else if (n.equals(\"CONO\") || n.equals(\"OKCONO\") || n.equals(\"IDCONO\")) {",
      "        eventData.put(\"CONO\", v.trim());",
      "    } else {",
      "        eventData.put(n, v.trim());",
      "    }",
      "}"
     ]
    }
   ]
  },
  {
   "java": "ManageEventData",
   "desc": "Validate the event: delete -> abort, missing CUNO/CONO -> MeCError",
   "in": {
    "iOperation": "IN:/EventData/Operation",
    "iDocumentName": "IN:/EventData/DocumentName",
    "iEventId": "IN:/EventData/EventId"
   },
   "out": {
    "oCONO": [
     "$CONO"
    ],
    "oCUNO": [
     "$CUNO"
    ]
   },
   "code": [
    "String op = (iOperation == null) ? \"\" : iOperation.trim().toUpperCase();",
    "String doc = (iDocumentName == null) ? \"\" : iDocumentName.trim();",
    "String evt = (iEventId == null) ? \"\" : iEventId.trim();",
    "oCONO = eventData.get(\"CONO\");",
    "oCUNO = eventData.get(\"CUNO\");",
    "oCONO = (oCONO == null) ? \"\" : oCONO.trim();",
    "oCUNO = (oCUNO == null) ? \"\" : oCUNO;",
    "",
    "// Delete events: the customer no longer exists in M3 - end without output",
    "if (op.equals(\"D\") || op.equals(\"DELETE\")) {",
    "    logInfo(\"CustomerDetails: delete event \" + evt + \" for customer '\" + oCUNO + \"' - no BOD produced\");",
    "    abort(\"CustomerDetails: delete event - no Sync.CustomerDetails BOD\");   // ends the mapping, no output",
    "} else {",
    "    // Mandatory keys",
    "    if (IONToolbox.isEmpty(oCUNO)) {",
    "        throw new MeCError(\"CustomerDetails: customer number (CUNO/OKCUNO/IDCUNO) missing in event \" + evt + \" [\" + doc + \"]\");",
    "    }",
    "    if (IONToolbox.isEmpty(oCONO)) {",
    "        throw new MeCError(\"CustomerDetails: company (CONO/OKCONO/IDCONO) missing in event \" + evt + \" for customer \" + oCUNO);",
    "    }",
    "    logDebug(\"CustomerDetails: event \" + evt + \" op=\" + op + \" CONO=\" + oCONO + \" CUNO=\" + oCUNO);",
    "}"
   ]
  },
  {
   "java": "GetCONO_DIVI_AE",
   "desc": "Format company, company-level accounting entity",
   "in": {
    "iCONO": "$CONO"
   },
   "out": {
    "oCONO": [
     "$CONO"
    ],
    "oAE": [
     "$bodAE"
    ]
   },
   "code": [
    "// Get CONO",
    "oCONO = IONToolbox.formatCompany(iCONO);",
    "",
    "// Customer master is company-level: accounting entity from M3 company only",
    "oAE = IONToolbox.getAccountingEntityId(oCONO, null);"
   ]
  },
  {
   "settings": {
    "Company": "GetCONO_DIVI_AE.oCONO"
   }
  },
  {
   "java": "Init",
   "desc": "DataTranslator, tenant id, control properties",
   "in": {
    "iCONO": "GetCONO_DIVI_AE.oCONO",
    "iTenantId": "IN:/EventData/TenantId"
   },
   "code": [
    "// Trim CONO:",
    "iCONO = iCONO == null ? \"\" : iCONO.trim();",
    "",
    "// Instantiate generic DataTranslator",
    "String blankDIVI = \"\";",
    "dtGen = new DataTranslator(getManifestMap(), iCONO, blankDIVI, \"ION\", \"1\", \"Generic\");",
    "",
    "// Set tenant id",
    "if (iTenantId == null) {",
    "    // On-premise: Translate M3 BE company to tenant id",
    "    tenantID = dtGen.toMessage(\"Generic\", \"TenantID\", iCONO, \"\", \"\", \"CMNCMP\", \"CONO\");",
    "    setManifestInfo(ManifestConstants.MAP_ION_TENANT_ID, tenantID);",
    "}",
    "",
    "// Control property StrictListCheck (default true): list API failure fails the message",
    "String strict = getManifestInfo(\"agr:StrictListCheck\");",
    "strictLists = !(strict != null && strict.trim().equalsIgnoreCase(\"false\"));"
   ]
  },
  {
   "api": "CRS610MI/GetUserInfo",
   "mode": "AVM",
   "in": {},
   "out": {
    "ZDLANC": [
     "$LANC"
    ]
   },
   "desc": "User language for the BOD languageCode"
  },
  {
   "api": "CRS610MI/GetBasicData",
   "mode": "AVI",
   "in": {
    "CUNO": "$CUNO"
   },
   "out": {},
   "desc": "Customer basic data (OCUSMA/CIDMAS) - NOK checked in ValidateCustomer"
  },
  {
   "java": "ValidateCustomer",
   "desc": "Invalid customer / API failure / empty response -> MeCError (no BOD)",
   "in": {
    "iCUNO": "GetBasicData.CUNO"
   },
   "code": [
    "if (!isLastAPICallOK()) {",
    "    throw new MeCError(\"CustomerDetails: CRS610MI/GetBasicData failed for customer \" + CUNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage());",
    "}",
    "String rCUNO = (iCUNO == null) ? \"\" : IONToolbox.rightTrim(iCUNO);",
    "if (IONToolbox.isEmpty(rCUNO)) {",
    "    throw new MeCError(\"CustomerDetails: CRS610MI/GetBasicData returned no data for customer \" + CUNO);",
    "}",
    "if (!rCUNO.equals(CUNO)) {",
    "    throw new MeCError(\"CustomerDetails: CRS610MI/GetBasicData returned customer \" + rCUNO + \" for requested customer \" + CUNO);",
    "}"
   ]
  },
  {
   "api": "CRS610MI/GetFinancial",
   "mode": "AVI",
   "in": {
    "CUNO": "$CUNO"
   },
   "out": {},
   "desc": "Customer financial data - NOK checked in ValidateFinancial"
  },
  {
   "java": "ValidateFinancial",
   "desc": "CRS610MI/GetFinancial failure -> MeCError (no BOD)",
   "code": [
    "if (!isLastAPICallOK()) {",
    "    throw new MeCError(\"CustomerDetails: CRS610MI/GetFinancial failed for customer \" + CUNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage());",
    "}"
   ]
  },
  {
   "api": "CRS610MI/GetOrderInfo",
   "mode": "AVI",
   "in": {
    "CUNO": "$CUNO"
   },
   "out": {},
   "desc": "Customer order/sales data - NOK checked in ValidateOrderInfo"
  },
  {
   "java": "ValidateOrderInfo",
   "desc": "CRS610MI/GetOrderInfo failure -> MeCError (no BOD)",
   "code": [
    "if (!isLastAPICallOK()) {",
    "    throw new MeCError(\"CustomerDetails: CRS610MI/GetOrderInfo failed for customer \" + CUNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage());",
    "}"
   ]
  },
  {
   "loop": "AddressLoop",
   "cond": "WT",
   "desc": "One iteration per CRS610MI/LstAddresses row",
   "body": [
    {
     "api": "CRS610MI/LstAddresses",
     "mode": "ARI",
     "in": {
      "CUNO": "$CUNO"
     },
     "out": {},
     "desc": "List customer addresses (NOK checked in CheckAddress)"
    },
    {
     "java": "CollectAddress",
     "in": {
      "iCUNO": "LstAddresses.CUNO",
      "iADRT": "LstAddresses.ADRT",
      "iADID": "LstAddresses.ADID",
      "iCUNM": "LstAddresses.CUNM",
      "iCUA1": "LstAddresses.CUA1",
      "iCUA2": "LstAddresses.CUA2",
      "iCUA3": "LstAddresses.CUA3",
      "iCUA4": "LstAddresses.CUA4",
      "iPONO": "LstAddresses.PONO",
      "iTOWN": "LstAddresses.TOWN",
      "iCSCD": "LstAddresses.CSCD",
      "iECAR": "LstAddresses.ECAR",
      "iFRCO": "LstAddresses.FRCO",
      "iTXCO": "LstAddresses.TXCO",
      "iPHNO": "LstAddresses.PHNO",
      "iTFNO": "LstAddresses.TFNO",
      "iYREF": "LstAddresses.YREF",
      "iMODL": "LstAddresses.MODL",
      "iTEDL": "LstAddresses.TEDL",
      "iTAXC": "LstAddresses.TAXC",
      "iVRNO": "LstAddresses.VRNO",
      "iADVI": "LstAddresses.ADVI",
      "iROUT": "LstAddresses.ROUT",
      "iRODN": "LstAddresses.RODN",
      "iULZO": "LstAddresses.ULZO",
      "iFVDT": "LstAddresses.FVDT",
      "iLVDT": "LstAddresses.LVDT",
      "iADCG": "LstAddresses.ADCG",
      "iPRIO": "LstAddresses.PRIO",
      "iEALO": "LstAddresses.EALO"
     },
     "out": {},
     "code": [
      "// One call per row returned by CRS610MI/LstAddresses. The list is positioned on the customer key,",
      "// so rows of other customers are skipped; only exact matches are kept.",
      "String rCUNO = (iCUNO == null) ? \"\" : IONToolbox.rightTrim(iCUNO);",
      "if (rCUNO.equals(CUNO)) {",
      "    String[] row = new String[29];",
      "    row[0] = (iADRT == null) ? \"\" : iADRT.trim();   // AddressType",
      "    row[1] = (iADID == null) ? \"\" : iADID.trim();   // AddressNumber",
      "    row[2] = (iCUNM == null) ? \"\" : iCUNM.trim();   // Name",
      "    row[3] = (iCUA1 == null) ? \"\" : iCUA1.trim();   // Address1",
      "    row[4] = (iCUA2 == null) ? \"\" : iCUA2.trim();   // Address2",
      "    row[5] = (iCUA3 == null) ? \"\" : iCUA3.trim();   // Address3",
      "    row[6] = (iCUA4 == null) ? \"\" : iCUA4.trim();   // Address4",
      "    row[7] = (iPONO == null) ? \"\" : iPONO.trim();   // PostalCode",
      "    row[8] = (iTOWN == null) ? \"\" : iTOWN.trim();   // City",
      "    row[9] = (iCSCD == null) ? \"\" : iCSCD.trim();   // CountryCode",
      "    row[10] = (iECAR == null) ? \"\" : iECAR.trim();   // AreaState",
      "    row[11] = (iFRCO == null) ? \"\" : iFRCO.trim();   // CountyID",
      "    row[12] = (iTXCO == null) ? \"\" : iTXCO.trim();   // County",
      "    row[13] = (iPHNO == null) ? \"\" : iPHNO.trim();   // Phone1",
      "    row[14] = (iTFNO == null) ? \"\" : iTFNO.trim();   // Fax",
      "    row[15] = (iYREF == null) ? \"\" : iYREF.trim();   // YourReference",
      "    row[16] = (iMODL == null) ? \"\" : iMODL.trim();   // DeliveryMethod",
      "    row[17] = (iTEDL == null) ? \"\" : iTEDL.trim();   // TermsOfDelivery",
      "    row[18] = (iTAXC == null) ? \"\" : iTAXC.trim();   // TaxCode",
      "    row[19] = (iVRNO == null) ? \"\" : iVRNO.trim();   // VATRegistrationNumber",
      "    row[20] = (iADVI == null) ? \"\" : iADVI.trim();   // ViaAddress",
      "    row[21] = (iROUT == null) ? \"\" : iROUT.trim();   // Route",
      "    row[22] = (iRODN == null) ? \"\" : iRODN.trim();   // RouteDeparture",
      "    row[23] = (iULZO == null) ? \"\" : iULZO.trim();   // UnloadingZone",
      "    String dFVDT = (iFVDT == null) ? \"\" : iFVDT.trim();",
      "    if (dFVDT.equals(\"0\") || dFVDT.equals(\"00000000\")) dFVDT = \"\";",
      "    row[24] = (dFVDT.length() == 8) ? dFVDT.substring(0, 4) + \"-\" + dFVDT.substring(4, 6) + \"-\" + dFVDT.substring(6, 8) : dFVDT;   // ValidFrom",
      "    String dLVDT = (iLVDT == null) ? \"\" : iLVDT.trim();",
      "    if (dLVDT.equals(\"0\") || dLVDT.equals(\"00000000\")) dLVDT = \"\";",
      "    row[25] = (dLVDT.length() == 8) ? dLVDT.substring(0, 4) + \"-\" + dLVDT.substring(4, 6) + \"-\" + dLVDT.substring(6, 8) : dLVDT;   // ValidTo",
      "    row[26] = (iADCG == null) ? \"\" : iADCG.trim();   // AddressCategory",
      "    row[27] = (iPRIO == null) ? \"\" : iPRIO.trim();   // Priority",
      "    row[28] = (iEALO == null) ? \"\" : iEALO.trim();   // EANLocation",
      "    g_Adr.add(row);",
      "}"
     ],
     "desc": "Keep rows of the event customer in g_Adr"
    }
   ]
  },
  {
   "java": "CheckAddress",
   "code": [
    "// Runs after the CRS610MI/LstAddresses loop: the last API call is the list call itself.",
    "if (!isLastAPICallOK()) {",
    "    String msg = \"CustomerDetails: CRS610MI/LstAddresses failed for customer \" + CUNO + \" (CONO \" + CONO + \"): \" + getLastAPIMessage();",
    "    if (strictLists) {",
    "        throw new MeCError(msg);   // never send a BOD with a section silently missing",
    "    }",
    "    logWarn(msg + \" - address section omitted (StrictListCheck=false)\");",
    "    g_Adr.clear();",
    "}",
    "logDebug(\"CustomerDetails: \" + g_Adr.size() + \" address record(s) for customer \" + CUNO);"
   ],
   "desc": "API failure on CRS610MI/LstAddresses: fail the message (default) or omit the section"
  },
  {
   "java": "SetOutboxHeaderData",
   "desc": "BOD type, accounting entity, target logical id, document id",
   "code": [
    "// BODType, hard coded here",
    "setManifestInfo(ManifestConstants.MAP_ION_BOD_TYPE, \"Sync.CustomerDetails\"); // \"map:ionBODType\"",
    "",
    "// AccountingEntityID",
    "setManifestInfo(ManifestConstants.MAP_ION_ACCOUNTING_ENTITY, bodAE); // \"map:ionAccountingEntity\"",
    "",
    "// ToLogicalId, set from event when present",
    "if (!IONToolbox.isEmpty(eventData.get(\"ToLogicalId\"))) {",
    "    setManifestInfo(ManifestConstants.MAP_ION_TO_LOGICAL_ID, eventData.get(\"ToLogicalId\")); // \"map:ionToLogicalId\"",
    "}",
    "",
    "// Document id shown in ION OneView",
    "setManifestInfo(ManifestConstants.MAP_ION_DOCUMENT_ID, CUNO); // \"map:ionDocumentId\""
   ]
  },
  {
   "java": "SetHeader",
   "desc": "BOD root attributes and ApplicationArea",
   "in": {
    "iCONO": "$CONO",
    "iLANC": "$LANC",
    "iSentTimestamp": "IN:/EventData/SentTimestamp",
    "iBODID": null
   },
   "out": {
    "oReleaseID": [
     "OUT:/SyncCustomerDetails[@releaseID]"
    ],
    "oVersionID": [
     "OUT:/SyncCustomerDetails[@versionID]"
    ],
    "oSystemEnvironmentCode": [
     "OUT:/SyncCustomerDetails[@systemEnvironmentCode]"
    ],
    "oLanguageCode": [
     "OUT:/SyncCustomerDetails[@languageCode]"
    ],
    "oLogicalID": [
     "OUT:/SyncCustomerDetails/ApplicationArea/Sender/LogicalID",
     "$LogicalID"
    ],
    "oLogicalID_schemeVersionID": [
     "OUT:/SyncCustomerDetails/ApplicationArea/Sender/LogicalID[@schemeVersionID]"
    ],
    "oComponentID": [
     "OUT:/SyncCustomerDetails/ApplicationArea/Sender/ComponentID"
    ],
    "oComponentID_schemeVersionID": [
     "OUT:/SyncCustomerDetails/ApplicationArea/Sender/ComponentID[@schemeVersionID]"
    ],
    "oConfirmationCode": [
     "OUT:/SyncCustomerDetails/ApplicationArea/Sender/ConfirmationCode"
    ],
    "oCreationDateTime": [
     "OUT:/SyncCustomerDetails/ApplicationArea/CreationDateTime"
    ],
    "oBODID": [
     "OUT:/SyncCustomerDetails/ApplicationArea/BODID"
    ]
   },
   "code": [
    "// Set OAGIS release",
    "oReleaseID = \"9.2\";",
    "",
    "// Set version of the given BOD definition",
    "oVersionID = \"1.0.0\";",
    "",
    "// Set \"Test\" or \"Production\" (default) mode",
    "oSystemEnvironmentCode = getSystemEnvironmentCode();",
    "",
    "// Set language for the contents of the BOD",
    "if (iLANC != null) {",
    "    oLanguageCode = dtGen.toMessage(\"Generic\", \"languageCode\", iLANC, \"\", \"\", \"CSYTAB\",\"LNCD\");",
    "}",
    "",
    "// Set from logical ID",
    "oLogicalID = getFromLogicalID();",
    "",
    "// Set MEC mapping version",
    "oLogicalID_schemeVersionID = getMappingVersion();",
    "",
    "// Set business application that issued the BOD",
    "oComponentID = \"M3BE\";",
    "",
    "// Set M3 BE version",
    "oComponentID_schemeVersionID = getBEVersion();",
    "",
    "// Set date time stamp that the given instance of the BOD was created (UTC)",
    "oCreationDateTime = IONToolbox.normalizeXMLDateTime(iSentTimestamp);",
    "",
    "// Set GUID that will make each BOD instance uniquely identifiable, default MEC message UUID",
    "if (iBODID != null) {",
    "    oBODID = iBODID;",
    "} else {",
    "    oBODID = getMapUUID();",
    "}",
    "// Set ConfirmationCode",
    "oConfirmationCode = \"OnError\";"
   ]
  },
  {
   "java": "SetSync",
   "desc": "Sync verb: accounting entity, location, action code",
   "in": {
    "iCONO": "$CONO",
    "iOperation": "IN:/EventData/Operation"
   },
   "out": {
    "oAccountingEntityID": [
     "OUT:/SyncCustomerDetails/DataArea/Sync/AccountingEntityID"
    ],
    "oLocationID": [
     "OUT:/SyncCustomerDetails/DataArea/Sync/LocationID"
    ],
    "oActionCode": [
     "OUT:/SyncCustomerDetails/DataArea/Sync/ActionCriteria/ActionExpression[@actionCode]"
    ]
   },
   "code": [
    "// Set accounting entity id",
    "oAccountingEntityID = (!IONToolbox.isEmpty(bodAE)) ? bodAE : \"\";",
    "",
    "// Customer master is company-level: no location",
    "oLocationID = \"\";",
    "",
    "// Set action code (C -> Add, U -> Replace)",
    "oActionCode = IONToolbox.createSyncActionCode(iOperation);"
   ]
  },
  {
   "java": "SetCustomerHeader",
   "desc": "Map CRS610MI/GetBasicData to CustomerDetails/CustomerHeader",
   "in": {
    "iCUNO": "GetBasicData.CUNO",
    "iCUNM": "GetBasicData.CUNM",
    "iCUA1": "GetBasicData.CUA1",
    "iCUA2": "GetBasicData.CUA2",
    "iCUA3": "GetBasicData.CUA3",
    "iCUA4": "GetBasicData.CUA4",
    "iPONO": "GetBasicData.PONO",
    "iTOWN": "GetBasicData.TOWN",
    "iCSCD": "GetBasicData.CSCD",
    "iECAR": "GetBasicData.ECAR",
    "iFRCO": "GetBasicData.FRCO",
    "iTXCO": "GetBasicData.TXCO",
    "iPHNO": "GetBasicData.PHNO",
    "iPHN2": "GetBasicData.PHN2",
    "iTFNO": "GetBasicData.TFNO",
    "iMAIL": "GetBasicData.MAIL",
    "iCUTP": "GetBasicData.CUTP",
    "iALCU": "GetBasicData.ALCU",
    "iYREF": "GetBasicData.YREF",
    "iYRE2": "GetBasicData.YRE2",
    "iSTAT": "GetBasicData.STAT",
    "iCUCD": "GetBasicData.CUCD",
    "iLNCD": "GetBasicData.LNCD",
    "iDIVI": "GetBasicData.DIVI",
    "iMCOS": "GetBasicData.MCOS",
